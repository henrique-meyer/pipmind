{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipmind:schema:v1:headline-relay",
  "title": "HeadlineRelay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relay_id",
    "headline",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "relay_id": {
      "type": "string",
      "minLength": 1
    },
    "headline": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    }
  }
}
