{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipmind:schema:v1:memory-repair",
  "type": "object",
  "additionalProperties": false,
  "required": ["working_memory", "memory_dispositions", "candidate_dispositions"],
  "properties": {
    "working_memory": {
      "allOf": [
        {"$ref": "urn:pipmind:schema:v1:working-memory"},
        {"properties": {
          "views": {"maxItems": 8, "uniqueItems": true, "items": {"maxLength": 300}},
          "waiting_for": {"maxItems": 8, "uniqueItems": true, "items": {"maxLength": 300}}
        }}
      ]
    },
    "memory_dispositions": {"$ref": "urn:pipmind:schema:v1:memory-repair#/$defs/compact-dispositions"},
    "candidate_dispositions": {"$ref": "urn:pipmind:schema:v1:memory-repair#/$defs/compact-dispositions"}
  },
  "$defs": {
    "compact-dispositions": {
      "allOf": [
        {"$ref": "urn:pipmind:schema:v1:memory-dispositions"},
        {"items": {"properties": {"reason": {"maxLength": 80}}}}
      ]
    }
  }
}
