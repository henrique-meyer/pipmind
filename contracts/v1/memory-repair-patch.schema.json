{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipmind:schema:v1:memory-repair-patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["replacements"],
  "properties": {
    "replacements": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "text", "reason", "evidence_ids"],
        "properties": {
          "from": {"type": "string", "pattern": "^[vw][0-9]+$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 300},
          "reason": {"type": "string", "minLength": 8, "maxLength": 80},
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 16,
            "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
