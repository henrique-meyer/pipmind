{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipmind:schema:v1:markdown-front-matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "part",
    "ts",
    "source_trader",
    "evidence_ids",
    "override",
    "rule_version",
    "rule_status",
    "suggestion_disposition",
    "rule_id",
    "playbook_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "part": {
      "enum": [
        "identity",
        "playbook",
        "working_memory",
        "journal",
        "review",
        "memory",
        "playbook_history"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "source_trader": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "override": {
      "type": "boolean"
    },
    "rule_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "rule_status": {
      "enum": [
        "active",
        "retired",
        "none"
      ]
    },
    "suggestion_disposition": {
      "enum": [
        "adopt",
        "trial",
        "reject",
        "none"
      ]
    },
    "rule_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "playbook_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
