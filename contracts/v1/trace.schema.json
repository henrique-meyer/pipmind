{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipmind:schema:v1:trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "seen",
    "triage",
    "decisions",
    "refusals",
    "tool_requests",
    "dispatches",
    "proposals",
    "final_mind",
    "guard_records",
    "commands",
    "reviews",
    "public_snapshots",
    "usage",
    "tool_results"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "seen": {
      "type": "array",
      "items": {
        "$ref": "urn:pipmind:schema:v1:event-envelope"
      }
    },
    "triage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "ts",
          "wake",
          "summary"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|\\+00:00)$"
          },
          "wake": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "urn:pipmind:schema:v1:decision-record"
      }
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "ts",
          "code"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|\\+00:00)$"
          },
          "code": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tool_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "ts",
          "name",
          "arguments",
          "allowed"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|\\+00:00)$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "dispatches": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "urn:pipmind:schema:v1:decision-record"
      }
    },
    "final_mind": {
      "$ref": "urn:pipmind:schema:v1:mind"
    },
    "guard_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control",
          "refused",
          "journaled"
        ],
        "properties": {
          "control": {
            "type": "string",
            "minLength": 1
          },
          "refused": {
            "type": "boolean"
          },
          "journaled": {
            "type": "boolean"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "dispatch_count"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 1
          },
          "dispatch_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "previous_version",
          "version",
          "evidence_ids",
          "refused"
        ],
        "properties": {
          "action": {
            "enum": [
              "add",
              "sharpen",
              "retire"
            ]
          },
          "previous_version": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "refused": {
            "type": "boolean"
          }
        }
      }
    },
    "public_snapshots": {
      "type": "array",
      "items": {
        "$ref": "urn:pipmind:schema:v1:public-snapshot"
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_calls",
        "input_tokens",
        "output_tokens",
        "estimated_cost_usd",
        "latency_ms"
      ],
      "properties": {
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tool_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "name",
          "result"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "result": {
            "type": [
              "object",
              "array"
            ]
          }
        }
      }
    }
  }
}
