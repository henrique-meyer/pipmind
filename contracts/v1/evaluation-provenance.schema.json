{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipmind:schema:v1:evaluation-provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "runner_mode", "selected_cases_sha256", "case_hash_domain", "cases", "repetitions", "available_capabilities", "declared_build", "configured_model", "artifact_scope", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "local-evidence-only"},
    "runner_mode": {"const": "fixture-working-state"},
    "selected_cases_sha256": {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/hash"},
    "case_hash_domain": {"const": "canonical-single-case-list"},
    "cases": {"type": "array", "minItems": 1, "maxItems": 12, "items": {
      "type": "object", "additionalProperties": false, "required": ["case_id", "sha256"],
      "properties": {"case_id": {"type": "string", "minLength": 1, "maxLength": 128}, "sha256": {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/hash"}}
    }},
    "repetitions": {"type": "integer", "minimum": 2, "maximum": 5},
    "available_capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["normal_prompt_version", "repair_prompt_version", "context_version", "working_policy_version", "working_budget", "working_codec_version", "usage_accounting_version", "grader_version"],
      "properties": {
        "normal_prompt_version": {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/version"},
        "repair_prompt_version": {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/version"},
        "context_version": {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/version"},
        "working_policy_version": {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/version"},
        "working_codec_version": {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/version"},
        "usage_accounting_version": {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/version"},
        "grader_version": {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/version"},
        "working_budget": {"type": "object", "additionalProperties": false, "required": ["version", "max_bytes", "max_entries_per_list", "max_text_bytes"], "properties": {
          "version": {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/version"},
          "max_bytes": {"type": "integer", "minimum": 1}, "max_entries_per_list": {"type": "integer", "minimum": 1}, "max_text_bytes": {"type": "integer", "minimum": 1}
        }}
      }
    },
    "declared_build": {"type": "object", "additionalProperties": false, "required": ["source", "value", "status"], "properties": {
      "source": {"const": "BUILD_SHA_environment"}, "status": {"enum": ["unverified", "unknown"]},
      "value": {"anyOf": [{"type": "null"}, {"const": "development"}, {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}]}
    }},
    "configured_model": {"type": "object", "additionalProperties": false,
      "required": ["kind", "execution_mode", "binding_sha256", "timeout_seconds", "factory_present", "provider_version_status", "rates_status"],
      "properties": {
        "kind": {"enum": ["foundry", "fixture", "unknown"]},
        "execution_mode": {"enum": ["configured-foundry-client", "configured-factory", "scripted", "unknown"]},
        "binding_sha256": {"anyOf": [{"type": "null"}, {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/hash"}]},
        "timeout_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "factory_present": {"type": ["boolean", "null"]},
        "provider_version_status": {"const": "unverified"}, "rates_status": {"const": "unverified"}
      }
    },
    "artifact_scope": {"const": "observed-on-disk-not-loaded-bytecode"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "status", "size_bytes", "raw_sha256", "lf_normalized_sha256"],
      "properties": {
        "path": {"enum": ["pipmind/shadow/model.py", "pipmind/shadow/context.py", "pipmind/shadow/engine.py", "pipmind/shadow/store.py", "pipmind/shadow/maintenance.py", "pipmind/shadow/working_refs.py", "pipmind/shadow/evaluations.py", "pipmind/shadow/evaluation_usage.py", "pipmind/shadow/evaluation_provenance.py", "evals/rubrics/quality-v1.json", "uv.lock", "contracts/v1/evaluation-provenance.schema.json", "contracts/v1/model-reply.schema.json", "contracts/v1/working-memory.schema.json", "contracts/v1/memory-dispositions.schema.json", "contracts/v1/memory-repair.schema.json"]},
        "status": {"enum": ["available", "missing", "unavailable", "oversize"]},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 1048576},
        "raw_sha256": {"anyOf": [{"type": "null"}, {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/hash"}]},
        "lf_normalized_sha256": {"anyOf": [{"type": "null"}, {"$ref": "urn:pipmind:schema:v1:evaluation-provenance#/$defs/hash"}]}
      }
    }}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
