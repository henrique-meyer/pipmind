{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipmind:schema:v1:memory-dispositions",
  "type": "array",
  "maxItems": 128,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "from",
      "to",
      "disposition",
      "reason",
      "evidence_ids"
    ],
    "properties": {
      "from": {
        "type": "string",
        "pattern": "^[vw][0-9]+$"
      },
      "to": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^[vw][0-9]+$"
          }
        ]
      },
      "disposition": {
        "enum": [
          "merged",
          "updated",
          "retained",
          "archived",
          "resolved"
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 8,
        "maxLength": 400
      },
      "evidence_ids": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
