{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipmind:schema:v1:clock-event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "ts",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "reason": {
      "enum": [
        "heartbeat",
        "daily_brief",
        "session_open",
        "session_close",
        "reconsideration"
      ]
    },
    "reconsideration_of": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "const": "reconsideration"
          }
        }
      },
      "then": {
        "required": [
          "reconsideration_of"
        ]
      },
      "else": {
        "not": {
          "required": [
            "reconsideration_of"
          ]
        }
      }
    }
  ]
}
