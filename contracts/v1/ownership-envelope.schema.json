{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipmind:schema:v1:ownership-envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "ownership",
    "accepted_at",
    "causation_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "$ref": "urn:pipmind:schema:v1:order-request"
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "generation",
        "lease_expires_at",
        "account_ref"
      ],
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "lease_expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "account_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "causation_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
